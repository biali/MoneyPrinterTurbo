# Jetson (aarch64 / NVIDIA L4T) image.
#
# Built on NVIDIA's l4t-jetpack base so CUDA, cuDNN and TensorRT are available
# inside the container. Dockerfile.gpu cannot be reused here: it starts from
# nvidia/cuda, whose arm64 variants target SBSA server GPUs and do not run on
# Tegra's integrated GPU.
#
# The base tag must match the board's L4T release, otherwise the userspace CUDA
# libraries and the host kernel driver disagree:
#   r36.4.0 -> JetPack 6.1        r36.3.0 -> JetPack 6.0
#   r35.4.1 -> JetPack 5.1.2      r35.3.1 -> JetPack 5.1.1
# Check with `cat /etc/nv_tegra_release` on the host, or let
# scripts/install-jetson.sh detect it.
ARG L4T_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${L4T_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /MoneyPrinterTurbo
RUN chmod 777 /MoneyPrinterTurbo

# The l4t-jetpack bases ship Ubuntu's default interpreter (3.10 on r36, 3.8 on
# r35), both below the project's requires-python. uv installs a standalone
# CPython 3.11 for aarch64 and resolves from uv.lock, which is more reliable
# than adding a third-party Python PPA on top of an L4T image.
ENV PYTHONPATH="/MoneyPrinterTurbo" \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
    && rm -rf /var/lib/apt/lists/*

ARG UV_VERSION=latest
COPY --from=ghcr.io/astral-sh/uv:${UV_VERSION} /uv /uvx /usr/local/bin/

# Dependencies are installed before the source copy so that editing application
# code does not invalidate the (very slow, on-device) dependency layer.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .

# python/python3 resolve to the project environment for `python3 main.py` and
# for any exec into the container.
RUN ln -sf /opt/venv/bin/python /usr/local/bin/python \
    && ln -sf /opt/venv/bin/python /usr/local/bin/python3

# WebUI and API. Published on the host as 3200/8200 by docker-compose.jetson.yml.
EXPOSE 8501 8080

# 容器内部必须监听 0.0.0.0，对外暴露范围由 compose 的端口绑定地址决定。
CMD ["streamlit", "run", "./webui/Main.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.enableCORS=True", "--browser.gatherUsageStats=False", "--client.toolbarMode=minimal", "--logger.hideWelcomeMessage=True", "--server.showEmailPrompt=False"]
