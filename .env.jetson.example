# Environment for docker-compose.jetson.yml. Copy to .env next to the compose
# file (scripts/install-jetson.sh writes it for you):
#
#   cp .env.jetson.example .env
#
# Host ports. Deliberately non-standard so the stack coexists with other
# services on the same Jetson; 8501/8080 stay internal to the containers.
MPT_WEBUI_PORT=3200
MPT_API_PORT=8200

# Address the published ports bind to. 0.0.0.0 makes the WebUI reachable from
# the LAN — see the security note in docs/jetson-orin.md, the WebUI has no
# authentication. Use 127.0.0.1 to keep it on the Jetson only and reach it
# through an SSH tunnel.
MPT_BIND_ADDR=0.0.0.0

# Address Streamlit prints and builds browser URLs from. Set to the Jetson's
# LAN address.
MPT_HOST=192.168.1.156

# Container runtime. "nvidia" attaches the Orin's integrated GPU and needs
# nvidia-container-toolkit on the host; "runc" starts without the GPU.
MPT_RUNTIME=nvidia

# Only used by docker-compose.jetson-gpu.yml (the local CUDA build). Must match
# the board's L4T release — `cat /etc/nv_tegra_release`.
L4T_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
